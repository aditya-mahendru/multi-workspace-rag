# Server
PORT=8080
# Comma-separated list of allowed frontend origins (e.g. your Vercel URL + localhost for dev)
CORS_ORIGINS=http://localhost:5173

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Service role key: server-only, NEVER expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq (https://console.groq.com/keys) — chat + tool calling
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio (https://aistudio.google.com/apikey) — embeddings only
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Notifications tool: paste a Slack Incoming Webhook or Discord channel webhook URL
NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
NOTIFY_WEBHOOK_KIND=discord
